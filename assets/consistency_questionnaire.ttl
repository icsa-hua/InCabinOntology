# ------------------------
# Q21. Violation "Sleep=> Inattentive & Unresponsive"
# ------------------------
# SELECT ?state ?fat ?att ?unresp
# WHERE {
#   ?state rdf:type :ActorState ;
#          :ActorStateHasFatigue :sleep_instance .
#
#   OPTIONAL { ?state :ActorStateHasAttention ?att . }
#   OPTIONAL { ?state :ActorStateHasUnresponsiveness ?unresp . }
#
#   FILTER ( !BOUND(?att) || ?att != :inattentive_instance
#         || !BOUND(?unresp) || ?unresp != :unresponsive_instance )
# }

# ------------------------
# Q22. Violation "Drowsy & attentive=> at-risk unresponsiveness"
# ------------------------
# SELECT ?state ?unresp
# WHERE {
#   ?state rdf:type :ActorState ;
#          :ActorStateHasFatigue :drowsinesssuspected_instance ;
#          :ActorStateHasAttention :attentive_instance .
#
#   OPTIONAL { ?state :ActorStateHasUnresponsiveness ?unresp . }
#
#   FILTER ( !BOUND(?unresp) || ?unresp != :undefined_atrisk_instance )
# }

# ------------------------
# Q23. Violation "Sleep or unresponsiveness => eyes closed & mouth open"
# ------------------------
# SELECT ?state ?fat ?unresp ?eye ?mouth
# WHERE {
#   ?state rdf:type :ActorState .
#
#   OPTIONAL { ?state :ActorStateHasFatigue ?fat . }
#   OPTIONAL { ?state :ActorStateHasUnresponsiveness ?unresp . }
#   OPTIONAL { ?state :ActorHasEyeState ?eye . }
#   OPTIONAL { ?state :ActorHasMouthState ?mouth . }
#
#   FILTER (
#     ( (?fat = :sleep_instance) || (?unresp = :unresponsive_instance) )
#     &&
#     ( !BOUND(?eye) || ?eye != :eyes_closed_instance
#       || !BOUND(?mouth) || ?mouth != :mouth_open_instance )
#   )
# }

