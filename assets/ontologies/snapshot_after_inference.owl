<owl:ObjectProperty rdf:about="#RRis">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <owl:inverseOf rdf:resource="#isForRR"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#RR"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#High_RR"/>
        <rdf:Description rdf:about="#Low_RR"/>
        <rdf:Description rdf:about="#Moderate_RR"/>
        <rdf:Description rdf:about="#Very_Low_RR"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isForRR">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#High_RR"/>
        <rdf:Description rdf:about="#Low_RR"/>
        <rdf:Description rdf:about="#Moderate_RR"/>
        <rdf:Description rdf:about="#Very_Low_RR"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#RR"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#SpO2is">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <owl:inverseOf rdf:resource="#isForSpO2"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#SpO2"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Critical_SpO2"/>
        <rdf:Description rdf:about="#Low_SpO2"/>
        <rdf:Description rdf:about="#Normal_SpO2"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isForSpO2">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Critical_SpO2"/>
        <rdf:Description rdf:about="#Low_SpO2"/>
        <rdf:Description rdf:about="#Normal_SpO2"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#SpO2"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#StateHasThresholdProfile">
  <owl:inverseOf rdf:resource="#THRPIsOfActorState"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#ThresholdProfile"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#THRPIsOfActorState">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#ThresholdProfile"/>
  <rdfs:range rdf:resource="#ActorState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#TempAffectActor">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="#WeatherCondition"/>
  <rdfs:range rdf:resource="#ActorState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#TemperatureBelongsToGroup">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#WeatherCondition"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ColdTemp"/>
        <rdf:Description rdf:about="#HotTemp"/>
        <rdf:Description rdf:about="#ModerateTemp"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#UnresponsiveIs">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <owl:inverseOf rdf:resource="#isForUnresponsive"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Unresponsiveness"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Imminent"/>
        <rdf:Description rdf:about="#Responsive"/>
        <rdf:Description rdf:about="#Undefined_AtRisk"/>
        <rdf:Description rdf:about="#Unresponsive"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isForUnresponsive">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Imminent"/>
        <rdf:Description rdf:about="#Responsive"/>
        <rdf:Description rdf:about="#Undefined_AtRisk"/>
        <rdf:Description rdf:about="#Unresponsive"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Unresponsiveness"/>
</owl:ObjectProperty>

