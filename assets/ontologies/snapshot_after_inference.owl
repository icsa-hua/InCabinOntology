<?xml version="1.0"?>
<rdf:RDF xmlns="http://test.org/in_cabin_domain#"
     xml:base="http://test.org/in_cabin_domain"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:in_c="http://test.org.org/in_cabin_domain#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:x_1.1="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="http://test.org/in_cabin_domain">
        <owl:versionIRI rdf:resource="http://test.org/in_cabin_domain_01"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://test.org.org/vehicleOntology#wktLiteral -->

    <rdfs:Datatype rdf:about="http://test.org.org/vehicleOntology#wktLiteral">
        <x_1.1:creator>jimge</x_1.1:creator>
        <x_1.1:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-07-28T10:51:28Z</x_1.1:date>
        <rdfs:comment>Well-known type for geospatial information</rdfs:comment>
    </rdfs:Datatype>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://test.org.org/in_cabin_domain#ActorIsTargetedByLabel -->

    <owl:ObjectProperty rdf:about="http://test.org.org/in_cabin_domain#ActorIsTargetedByLabel">
        <owl:inverseOf rdf:resource="http://test.org.org/in_cabin_domain#LabelTargetsActor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Label"/>
        <rdfs:comment>The driver is described by the label. As an example: 
middle-aged afghan man with glasses_eyes_closed_mouth_open</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://test.org.org/in_cabin_domain#LabelTargetsActor -->

    <owl:ObjectProperty rdf:about="http://test.org.org/in_cabin_domain#LabelTargetsActor">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Label"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:comment>This property indicates that the alert is meant for a particular target. This show that each alert is directed at one or more specific targes.
Since the alert is a message it only regards the occupants of the vehicle.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://test.org.org/in_cabin_domain#SensorCapturesObservations -->

    <owl:ObjectProperty rdf:about="http://test.org.org/in_cabin_domain#SensorCapturesObservations">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#ObservationsAreCapturedBySensor"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#MonitoringSensor"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:comment>This object property denotes the relationship between the Observations which can either be time series data or image data, which are captured by the sensors. Different Sensors capture different type of data based also on what the target is.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#AccessoriesIncludeWearables -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#AccessoriesIncludeWearables">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#WearablesIncludedInAccessories"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Accessories"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Glasses"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Hat"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Scarf"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorFromObservations -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorFromObservations">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Accessories"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Age"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Demographic"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#FaceCharacteristics"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Sex"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Observations"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorHasEyeState -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorHasEyeState">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#EyeStateForActor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#EyeState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorHasMouthState -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorHasMouthState">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#MouthStateForActor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#MouthState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorIsAffectedByTemp -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorIsAffectedByTemp">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#WeatherCondition"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorIsMonitoredBySensor -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorIsMonitoredBySensor">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#SensorMonitorsActor"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#MonitoringSensor"/>
        <rdfs:comment>The driver is monitored in some way and with some external gudgets from sensors. This implies that the time series values are regarding the driver&apos;s health.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasAccessories -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasAccessories">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Accessories"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasAge -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasAge">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Age"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasAttention -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasAttention">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#AttentionLevels"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasCharacteristics -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasCharacteristics">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Demographic"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#FaceCharacteristics"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasFatigue -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasFatigue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Fatigue"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasPhysiologicalState -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasPhysiologicalState">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Drowsiness"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#SpO2"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasSex -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasSex">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Sex"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorStateHasUnresponsiveness -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorStateHasUnresponsiveness">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Unresponsiveness"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ActorhasState -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ActorhasState">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#StateOfActor"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Actor"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#AgeBelongsToGroup -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#AgeBelongsToGroup">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#GroupIsOfAge"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Age"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Elderly"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Middle-Aged"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Young"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#AttentionIs -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#AttentionIs">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#IsForAttention"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#AttentionLevels"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Attentive"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Inattentive"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Undefined"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#DenotesTemperature -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#DenotesTemperature">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#TemperatureDenotedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Accessories"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#WeatherCondition"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#DrowsinessIs -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#DrowsinessIs">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForDrowsiness"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Drowsiness"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_3_KSS"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_5_KSS"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_7_KSS"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_9_KSS"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#DrowsinessLevelSuggested -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#DrowsinessLevelSuggested">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Drowsiness"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_3_KSS"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_5_KSS"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_7_KSS"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Level_9_KSS"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#EyeStateForActor -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#EyeStateForActor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#EyeState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#EyeStateIs -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#EyeStateIs">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForEyeState"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#EyeState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#EyeState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#FatigueIs -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#FatigueIs">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForFatigue"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Fatigue"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Awake"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#DrowsinessSuspected"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Sleep"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#UndefinedState"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#GroupIsOfAge -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#GroupIsOfAge">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Elderly"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Middle-Aged"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Young"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Age"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#GroupIsOfSex -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#GroupIsOfSex">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#SexBelongsToGroup"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Female"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Male"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Sex"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#HRVis -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#HRVis">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForHRV"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#HRV"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#High_HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Low_HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Moderate_HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Very_Low_HRV"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#HRis -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#HRis">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForHR"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#HR"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#High_HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Low_HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Moderate_HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Very_Low_HR"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#HasThreshold -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#HasThreshold">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isThreshold"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#SpO2"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Thresholds"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#IsForAttention -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#IsForAttention">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Attentive"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Inattentive"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Undefined"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#AttentionLevels"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#MouthStateForActor -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#MouthStateForActor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#MouthState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#MouthStateIs -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#MouthStateIs">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForMouthState"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#MouthState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#MouthState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ObsIsDividedIntoActor -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ObsIsDividedIntoActor">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Accessories"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Age"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Demographic"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#FaceCharacteristics"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Sex"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ObsIsDividedIntoPhS -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ObsIsDividedIntoPhS">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#PhSFromObservations"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Drowsiness"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#SpO2"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#ObservationsAreCapturedBySensor -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#ObservationsAreCapturedBySensor">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#MonitoringSensor"/>
        <rdfs:comment>Observations are captured by the sensors, and different sensors capture different type of observations. These are the actual data used in the processing part of the ontology in the DAU, which wants to categorize the driver based on those values.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#PhSFromObservations -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#PhSFromObservations">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Drowsiness"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#SpO2"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Observations"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#RRis -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#RRis">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForRR"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#RR"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#High_RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Low_RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Moderate_RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Very_Low_RR"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#SensorMonitorsActor -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#SensorMonitorsActor">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#MonitoringSensor"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:comment>The sensor monitors the driver, to capture health moniroting information</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#SexBelongsToGroup -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#SexBelongsToGroup">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Sex"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Female"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Male"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#SpO2is -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#SpO2is">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForSpO2"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#SpO2"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Critical_SpO2"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Low_SpO2"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Normal_SpO2"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#StateHasThresholdProfile -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#StateHasThresholdProfile">
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#THRPIsOfActorState"/>
