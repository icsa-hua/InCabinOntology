    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#UnresponsiveIs -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#UnresponsiveIs">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://test.org/in_cabin_domain#isForUnresponsive"/>
