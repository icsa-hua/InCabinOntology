        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#TemporalContext"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasHRV -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasHRV">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasHRVRank -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasHRVRank">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#TemporalContext"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasNumericalValue -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasNumericalValue">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#PhysiologicalState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasRR -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasRR">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasRRRank -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasRRRank">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#TemporalContext"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasSex -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasSex">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasSpO2 -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasSpO2">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasStringValue -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasStringValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Accessories"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Demographic"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#FaceCharacteristics"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Sex"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasTemporalValue -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasTemporalValue">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#TemporalContext"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasThrValue -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasThrValue">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Thresholds"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasUniqueIdentifier -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasUniqueIdentifier">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Actor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>This is the identity of the person as a UUIDv4 string which can be linked with the name and other personal information of the occupant. An example of this is &quot;23f5d284-bade-4a35-8732-8053ee7ac103&quot;.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasUnresponsivenessTrend -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasUnresponsivenessTrend">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#phyValidAt -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#phyValidAt">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#PhysiologicalState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#validAt -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#validAt">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://test.org.org/in_cabin_domain#DataAnalysisUnit -->

    <owl:Class rdf:about="http://test.org.org/in_cabin_domain#DataAnalysisUnit">
        <rdfs:subClassOf rdf:resource="http://test.org/in_cabin_domain#MonitoringManagement"/>
        <owl:disjointWith rdf:resource="http://test.org/in_cabin_domain#MonitoringSensor"/>
        <rdfs:comment>The virtual analysis unit to connect data and processing.</rdfs:comment>
    </owl:Class>
    


    <!-- http://test.org.org/in_cabin_domain#DataContainer -->

    <owl:Class rdf:about="http://test.org.org/in_cabin_domain#DataContainer">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>This class represents all the data that are passed in the ontology/system. 
It holds the data created after processing the observations captured by the sensors which are then passed into the analysis unit. Finally we store in this class the meta data which are the information of the external environment (weather, time of day, temperature, humidity, etc) and the thresholds which are predefined values for the health factors such as activity levels, fatigue levels, etc.</rdfs:comment>
    </owl:Class>
    


    <!-- http://test.org.org/in_cabin_domain#MetaData -->

    <owl:Class rdf:about="http://test.org.org/in_cabin_domain#MetaData">
        <rdfs:subClassOf rdf:resource="http://test.org.org/in_cabin_domain#DataContainer"/>
        <rdfs:comment>External environment information which will be kept into the ontology for further stages of health assesmnet if the corresponding data are available.</rdfs:comment>
    </owl:Class>
    


    <!-- http://test.org/in_cabin_domain#Accessories -->

    <owl:Class rdf:about="http://test.org/in_cabin_domain#Accessories">
        <rdfs:subClassOf rdf:resource="http://test.org/in_cabin_domain#Actor"/>
    </owl:Class>
    


    <!-- http://test.org/in_cabin_domain#Actor -->

    <owl:Class rdf:about="http://test.org/in_cabin_domain#Actor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://test.org/in_cabin_domain#PhysiologicalState"/>
    </owl:Class>
    


    <!-- http://test.org/in_cabin_domain#ActorState -->

    <owl:Class rdf:about="http://test.org/in_cabin_domain#ActorState">
        <rdfs:subClassOf rdf:resource="http://test.org.org/in_cabin_domain#DataContainer"/>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://test.org/in_cabin_domain#validAt"/>
        </owl:hasKey>
    </owl:Class>
    


    <!-- http://test.org/in_cabin_domain#ActorState_Critical_SpO2 -->

    <owl:Class rdf:about="http://test.org/in_cabin_domain#ActorState_Critical_SpO2">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#ActorState"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#ActorStateHasPhysiologicalState"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#SpO2"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#SpO2is"/>
                                        <owl:hasValue rdf:resource="http://test.org/in_cabin_domain#critical_spo2_instance"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
    </owl:Class>
    


    <!-- http://test.org/in_cabin_domain#ActorState_Drowsiness_Level_3 -->

    <owl:Class rdf:about="http://test.org/in_cabin_domain#ActorState_Drowsiness_Level_3">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#ActorState"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#ActorStateHasPhysiologicalState"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Drowsiness"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#DrowsinessIs"/>
                                        <owl:hasValue rdf:resource="http://test.org/in_cabin_domain#level_3_kss_instance"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
    </owl:Class>
    


    <!-- http://test.org/in_cabin_domain#ActorState_Drowsiness_Level_5 -->

    <owl:Class rdf:about="http://test.org/in_cabin_domain#ActorState_Drowsiness_Level_5">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#ActorState"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#ActorStateHasPhysiologicalState"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Drowsiness"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#DrowsinessIs"/>
                                        <owl:hasValue rdf:resource="http://test.org/in_cabin_domain#level_5_kss_instance"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
    </owl:Class>
    


    <!-- http://test.org/in_cabin_domain#ActorState_Drowsiness_Level_7 -->

    <owl:Class rdf:about="http://test.org/in_cabin_domain#ActorState_Drowsiness_Level_7">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#ActorState"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#ActorStateHasPhysiologicalState"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Drowsiness"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://test.org/in_cabin_domain#DrowsinessIs"/>
                                        <owl:hasValue rdf:resource="http://test.org/in_cabin_domain#level_7_kss_instance"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
