        <rdf:Description rdf:about="#RR"/>
        <rdf:Description rdf:about="#SpO2"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorStateHasSex">
