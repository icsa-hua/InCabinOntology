  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:disjointWith rdf:resource="#PhysiologicalState"/>
</owl:Class>

<owl:Class rdf:about="#Elderly">
  <rdfs:subClassOf rdf:resource="#Age"/>
</owl:Class>

<owl:Class rdf:about="#Middle-Aged">
  <rdfs:subClassOf rdf:resource="#Age"/>
</owl:Class>

<owl:Class rdf:about="#Young">
  <rdfs:subClassOf rdf:resource="#Age"/>
</owl:Class>

<owl:Class rdf:about="#Attentive">
  <rdfs:subClassOf rdf:resource="#AttentionLevels"/>
</owl:Class>

<owl:Class rdf:about="#Inattentive">
  <rdfs:subClassOf rdf:resource="#AttentionLevels"/>
</owl:Class>

<owl:Class rdf:about="#Undefined">
  <rdfs:subClassOf rdf:resource="#AttentionLevels"/>
</owl:Class>

<owl:Class rdf:about="#Level_3_KSS">
  <rdfs:subClassOf rdf:resource="#Drowsiness"/>
</owl:Class>

<owl:Class rdf:about="#Level_5_KSS">
  <rdfs:subClassOf rdf:resource="#Drowsiness"/>
</owl:Class>

<owl:Class rdf:about="#Level_7_KSS">
  <rdfs:subClassOf rdf:resource="#Drowsiness"/>
</owl:Class>

<owl:Class rdf:about="#Level_9_KSS">
  <rdfs:subClassOf rdf:resource="#Drowsiness"/>
</owl:Class>

<owl:Class rdf:about="#Awake">
  <rdfs:subClassOf rdf:resource="#Fatigue"/>
</owl:Class>

<owl:Class rdf:about="#DrowsinessSuspected">
  <rdfs:subClassOf rdf:resource="#Fatigue"/>
</owl:Class>

<owl:Class rdf:about="#Sleep">
  <rdfs:subClassOf rdf:resource="#Fatigue"/>
</owl:Class>

<owl:Class rdf:about="#UndefinedState">
  <rdfs:subClassOf rdf:resource="#Fatigue"/>
</owl:Class>

<owl:Class rdf:about="#Female">
  <rdfs:subClassOf rdf:resource="#Sex"/>
  <owl:disjointWith rdf:resource="#Male"/>
</owl:Class>

<owl:Class rdf:about="#Male">
  <rdfs:subClassOf rdf:resource="#Sex"/>
</owl:Class>

<owl:Class rdf:about="#High_HRV">
  <rdfs:subClassOf rdf:resource="#HRV"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values &gt; 100 ms (Excellent alertness, recovery and relaxation)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Low_HRV">
  <rdfs:subClassOf rdf:resource="#HRV"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values 20-50 ms (Mild fatigue, reduced focus)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Moderate_HRV">
  <rdfs:subClassOf rdf:resource="#HRV"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values 50-100ms</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Very_Low_HRV">
  <rdfs:subClassOf rdf:resource="#HRV"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values &lt;20 ms (Severe fatigue, stress, risk of drowsiness).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#High_HR">
  <rdfs:subClassOf rdf:resource="#HR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values &gt;100 bpm (Tachycardia, often due to stress, fatigue, or dehydration)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Low_HR">
  <rdfs:subClassOf rdf:resource="#HR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values 50-60bpm (indicating sleepiness)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Moderate_HR">
  <rdfs:subClassOf rdf:resource="#HR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values 60-100 bpm (Normal range, indicates alertness) for adults</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Very_Low_HR">
  <rdfs:subClassOf rdf:resource="#HR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;50 bpm (Bradycardia, common in highly fit individuals or fatigue/drowsiness)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Thresholds">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#High_RR">
  <rdfs:subClassOf rdf:resource="#RR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values &gt; 20 bpm (Stress, hypervenrilation or drowsiness)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Low_RR">
  <rdfs:subClassOf rdf:resource="#RR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values 12-14 breaths per minute (mild Fatigue, relaxation)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Moderate_RR">
  <rdfs:subClassOf rdf:resource="#RR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values 15-20 bpm (Normal, indicates alertness)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Very_Low_RR">
  <rdfs:subClassOf rdf:resource="#RR"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values &lt;12 (hypoventilation)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Critical_SpO2">
  <rdfs:subClassOf rdf:resource="#SpO2"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values &lt;85% (Severe hypoxia, risk of unconciousness)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Low_SpO2">
  <rdfs:subClassOf rdf:resource="#SpO2"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values 85-94% (Mild hypoxia, fatigue, drowsiness, low alertness)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Normal_SpO2">
  <rdfs:subClassOf rdf:resource="#SpO2"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Values between 95-100% (Healthy, alert state)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ThresholdProfile">
  <rdfs:subClassOf rdf:resource="#Thresholds"/>
</owl:Class>

<owl:Class rdf:about="#ColdTemp">
  <rdfs:subClassOf rdf:resource="#WeatherCondition"/>
  <owl:disjointWith rdf:resource="#HotTemp"/>
</owl:Class>

<owl:Class rdf:about="#HotTemp">
  <rdfs:subClassOf rdf:resource="#WeatherCondition"/>
</owl:Class>

<owl:Class rdf:about="#ModerateTemp">
  <rdfs:subClassOf rdf:resource="#WeatherCondition"/>
</owl:Class>

<owl:Class rdf:about="#Imminent">
  <rdfs:subClassOf rdf:resource="#Unresponsiveness"/>
</owl:Class>

<owl:Class rdf:about="#Responsive">
  <rdfs:subClassOf rdf:resource="#Unresponsiveness"/>
</owl:Class>

<owl:Class rdf:about="#Undefined_AtRisk">
  <rdfs:subClassOf rdf:resource="#Unresponsiveness"/>
</owl:Class>

<owl:Class rdf:about="#Unresponsive">
  <rdfs:subClassOf rdf:resource="#Unresponsiveness"/>
</owl:Class>

<owl:Class rdf:about="#HR_THR">
  <rdfs:subClassOf rdf:resource="#Thresholds"/>
</owl:Class>

<owl:Class rdf:about="#HRV_THR">
  <rdfs:subClassOf rdf:resource="#Thresholds"/>
</owl:Class>

<owl:Class rdf:about="#RR_THR">
  <rdfs:subClassOf rdf:resource="#Thresholds"/>
</owl:Class>

<owl:Class rdf:about="#SpO2_THR">
  <rdfs:subClassOf rdf:resource="#Thresholds"/>
</owl:Class>

<owl:Class rdf:about="#MonitoringManagement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the fundamental main class that involves the capturing (or loading) of the data and the processing in the analysis unit (which leverages the SWRL rules). The DAU is a virtual entity that is used to connect the data with the processing and back to the label. The sensor is a class to represent the different types of sensors that can be used.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TemporalContext">
  <rdfs:subClassOf rdf:resource="http://test.org.org/in_cabin_domain#MetaData"/>
</owl:Class>

<owl:Class rdf:about="#PhysiologicalState">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="http://test.org.org/in_cabin_domain#DataAnalysisUnit">
  <rdfs:subClassOf rdf:resource="#MonitoringManagement"/>
  <owl:disjointWith rdf:resource="#MonitoringSensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The virtual analysis unit to connect data and processing.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://test.org.org/in_cabin_domain#DataContainer">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class represents all the data that are passed in the ontology/system. 
It holds the data created after processing the observations captured by the sensors which are then passed into the analysis unit. Finally we store in this class the meta data which are the information of the external environment (weather, time of day, temperature, humidity, etc) and the thresholds which are predefined values for the health factors such as activity levels, fatigue levels, etc.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://test.org.org/in_cabin_domain#MetaData">
  <rdfs:subClassOf rdf:resource="http://test.org.org/in_cabin_domain#DataContainer"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">External environment information which will be kept into the ontology for further stages of health assesmnet if the corresponding data are available.</rdfs:comment>
</owl:Class>

