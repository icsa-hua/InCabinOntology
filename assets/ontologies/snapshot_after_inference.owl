        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasHRRank -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasHRRank">
