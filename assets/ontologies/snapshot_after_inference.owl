            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#HRV"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#isForMouthState -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#isForMouthState">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#MouthState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#MouthState"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#isForRR -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#isForRR">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#High_RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Low_RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Moderate_RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Very_Low_RR"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#RR"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#isForSpO2 -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#isForSpO2">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Critical_SpO2"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Low_SpO2"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Normal_SpO2"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#SpO2"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#isForUnresponsive -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#isForUnresponsive">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Imminent"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Responsive"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Undefined_AtRisk"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#Unresponsive"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#Unresponsiveness"/>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#isThreshold -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#isThreshold">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Thresholds"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#HRV"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#RR"/>
                    <rdf:Description rdf:about="http://test.org/in_cabin_domain#SpO2"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://test.org/in_cabin_domain#prevState -->

    <owl:ObjectProperty rdf:about="http://test.org/in_cabin_domain#prevState">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
    </owl:ObjectProperty>
    


