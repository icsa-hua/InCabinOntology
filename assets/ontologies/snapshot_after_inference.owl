    <!-- http://test.org.org/in_cabin_domain#hasID -->

    <owl:DatatypeProperty rdf:about="http://test.org.org/in_cabin_domain#hasID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#MonitoringManagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Identifier for the different systems</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://test.org.org/in_cabin_domain#hasSensorName -->

    <owl:DatatypeProperty rdf:about="http://test.org.org/in_cabin_domain#hasSensorName">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#MonitoringSensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>inserted the name of the sensor to categorize the sensor based on the rules defined.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasAccessories -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasAccessories">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasAge -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasAge">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasAgeValue -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasAgeValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Age"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <owl:propertyDisjointWith rdf:resource="http://test.org/in_cabin_domain#hasNumericalValue"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasAttentionTrend -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasAttentionTrend">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#ActorState"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasDemographic -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasDemographic">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasDescription -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasDescription">
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Label"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasDrowsy -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasDrowsy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://test.org/in_cabin_domain#Observations"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://test.org/in_cabin_domain#hasFaceCharacteristics -->

    <owl:DatatypeProperty rdf:about="http://test.org/in_cabin_domain#hasFaceCharacteristics">
