<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://test.org/in_cabin_domain"
         xmlns="http://test.org/in_cabin_domain#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:x_1.1="http://purl.org/dc/elements/1.1/"
         xmlns:in_c="http://test.org.org/in_cabin_domain#">

<owl:Ontology rdf:about="http://test.org/in_cabin_domain">
  <owl:versionIRI rdf:resource="http://test.org/in_cabin_domain_01"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="http://test.org.org/in_cabin_domain#ActorIsTargetedByLabel">
  <owl:inverseOf rdf:resource="http://test.org.org/in_cabin_domain#LabelTargetsActor"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#Label"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The driver is described by the label. As an example: 
middle-aged afghan man with glasses_eyes_closed_mouth_open</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://test.org.org/in_cabin_domain#LabelTargetsActor">
  <rdfs:domain rdf:resource="#Label"/>
  <rdfs:range rdf:resource="#ActorState"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This property indicates that the alert is meant for a particular target. This show that each alert is directed at one or more specific targes.
Since the alert is a message it only regards the occupants of the vehicle.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://test.org.org/in_cabin_domain#SensorCapturesObservations">
  <owl:inverseOf rdf:resource="#ObservationsAreCapturedBySensor"/>
  <rdfs:domain rdf:resource="#MonitoringSensor"/>
  <rdfs:range rdf:resource="#Observations"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This object property denotes the relationship between the Observations which can either be time series data or image data, which are captured by the sensors. Different Sensors capture different type of data based also on what the target is.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ObservationsAreCapturedBySensor">
  <rdfs:domain rdf:resource="#Observations"/>
  <rdfs:range rdf:resource="#MonitoringSensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observations are captured by the sensors, and different sensors capture different type of observations. These are the actual data used in the processing part of the ontology in the DAU, which wants to categorize the driver based on those values.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#AccessoriesIncludeWearables">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <owl:inverseOf rdf:resource="#WearablesIncludedInAccessories"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Accessories"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Glasses"/>
        <rdf:Description rdf:about="#Hat"/>
        <rdf:Description rdf:about="#Scarf"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#WearablesIncludedInAccessories">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Glasses"/>
        <rdf:Description rdf:about="#Hat"/>
        <rdf:Description rdf:about="#Scarf"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Accessories"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorFromObservations">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Accessories"/>
        <rdf:Description rdf:about="#Age"/>
        <rdf:Description rdf:about="#Demographic"/>
        <rdf:Description rdf:about="#FaceCharacteristics"/>
        <rdf:Description rdf:about="#Sex"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Observations"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorHasEyeState">
  <owl:inverseOf rdf:resource="#EyeStateForActor"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#EyeState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#EyeStateForActor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EyeState"/>
  <rdfs:range rdf:resource="#ActorState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorHasMouthState">
  <owl:inverseOf rdf:resource="#MouthStateForActor"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#MouthState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#MouthStateForActor">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="#MouthState"/>
  <rdfs:range rdf:resource="#ActorState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorIsAffectedByTemp">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#WeatherCondition"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorIsMonitoredBySensor">
  <owl:inverseOf rdf:resource="#SensorMonitorsActor"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#MonitoringSensor"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The driver is monitored in some way and with some external gudgets from sensors. This implies that the time series values are regarding the driver's health.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#SensorMonitorsActor">
  <rdfs:domain rdf:resource="#MonitoringSensor"/>
  <rdfs:range rdf:resource="#ActorState"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sensor monitors the driver, to capture health moniroting information</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorStateHasAccessories">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#Accessories"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorStateHasAge">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#Age"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorStateHasAttention">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#AttentionLevels"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorStateHasCharacteristics">
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Demographic"/>
        <rdf:Description rdf:about="#FaceCharacteristics"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorStateHasFatigue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range rdf:resource="#Fatigue"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#ActorStateHasPhysiologicalState">
  <rdfs:domain rdf:resource="#ActorState"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Drowsiness"/>
