</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#AgeBelongsToGroup">
  <owl:inverseOf rdf:resource="#GroupIsOfAge"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Age"/>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Elderly"/>
        <rdf:Description rdf:about="#Middle-Aged"/>
        <rdf:Description rdf:about="#Young"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#GroupIsOfAge">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
