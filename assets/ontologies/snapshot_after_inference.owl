        <rdf:Description rdf:about="#Young"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Age"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#AttentionIs">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <owl:inverseOf rdf:resource="#IsForAttention"/>
