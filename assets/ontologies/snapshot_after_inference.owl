  <rdfs:subClassOf rdf:resource="http://test.org.org/in_cabin_domain#MetaData"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This will represent the weather in the environment for example "sunny" .</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AttentionLevels">
  <rdfs:subClassOf rdf:resource="#PhysiologicalState"/>
</owl:Class>

<owl:Class rdf:about="#Fatigue">
  <rdfs:subClassOf rdf:resource="#PhysiologicalState"/>
</owl:Class>

<owl:Class rdf:about="#Drowsiness">
  <rdfs:subClassOf rdf:resource="#PhysiologicalState"/>
</owl:Class>

<owl:Class rdf:about="#HR">
  <rdfs:subClassOf rdf:resource="#PhysiologicalState"/>
</owl:Class>

<owl:Class rdf:about="#HRV">
  <rdfs:subClassOf rdf:resource="#PhysiologicalState"/>
</owl:Class>

<owl:Class rdf:about="#RR">
  <rdfs:subClassOf rdf:resource="#PhysiologicalState"/>
</owl:Class>

