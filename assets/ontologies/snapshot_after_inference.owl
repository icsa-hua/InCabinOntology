</owl:Class>

<owl:Class rdf:about="#Sex">
  <rdfs:subClassOf rdf:resource="#Actor"/>
</owl:Class>

<owl:Class rdf:about="#EyeState">
  <rdfs:subClassOf rdf:resource="#Actor"/>
