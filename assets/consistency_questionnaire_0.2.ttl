# ============================================================
# Consistency Questionnaire (SPARQL Queries)
# Stored as comments inside a Turtle (.ttl) file
# ============================================================


# ------------------------
# Q1. Missing physiological attributes
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState .
#   OPTIONAL { ?state :ActorStateHasPhysiologicalState ?hr . ?hr rdf:type :HR . }
#   OPTIONAL { ?state :ActorStateHasPhysiologicalState ?hrv . ?hrv rdf:type :HRV . }
#   OPTIONAL { ?state :ActorStateHasPhysiologicalState ?rr . ?rr rdf:type :RR . }
#   OPTIONAL { ?state :ActorStateHasPhysiologicalState ?spo2 . ?spo2 rdf:type :SpO2 . }
#   OPTIONAL { ?state :ActorStateHasPhysiologicalState ?drow . ?drow rdf:type :Drowsiness . }
#   FILTER ( !BOUND(?hr) || !BOUND(?hrv) || !BOUND(?rr) || !BOUND(?spo2) || !BOUND(?drow) )
# }

