# ------------------------
# Q18. Violation "Sleep=> Inattentive & Unresponsive"
# ------------------------
# SELECT ?state ?fat ?att ?unresp
# WHERE {
#   ?state rdf:type :ActorState ;
#          :ActorStateHasFatigue :sleep_instance .
#
#   OPTIONAL { ?state :ActorStateHasAttention ?att . }
#   OPTIONAL { ?state :ActorStateHasUnresponsiveness ?unresp . }
#
#   FILTER ( !BOUND(?att) || ?att != :inattentive_instance
#         || !BOUND(?unresp) || ?unresp != :unresponsive_instance )
# }

# ------------------------
# Q19. Violation "Drowsy & attentive=> at-risk unresponsiveness"
# ------------------------
# SELECT ?state ?unresp
# WHERE {
#   ?state rdf:type :ActorState ;
#          :ActorStateHasFatigue :drowsinesssuspected_instance ;
#          :ActorStateHasAttention :attentive_instance .
#
#   OPTIONAL { ?state :ActorStateHasUnresponsiveness ?unresp . }
#
#   FILTER ( !BOUND(?unresp) || ?unresp != :undefined_atrisk_instance )
# }

# ------------------------
# Q20. Violation "Sleep or unresponsiveness => eyes closed & mouth open"
# ------------------------
# SELECT ?state ?fat ?unresp ?eye ?eyeCat ?mouth
# WHERE {
#   ?state rdf:type :ActorState .
#
#   OPTIONAL { ?state :ActorStateHasFatigue ?fat . }
#   OPTIONAL { ?state :ActorStateHasUnresponsiveness ?unresp . }
#
#   # Eye state is an individual linked to a category via :EyeStateIs
#   OPTIONAL {
#     ?state :ActorHasEyeState ?eye .
#     ?eye   :EyeStateIs       ?eyeCat .
#   }
#
#   OPTIONAL { ?state :ActorHasMouthState ?mouth . }
#
#   FILTER (
#     ( (?fat = :Sleep) || (?unresp = :Unresponsive) )
#     &&
#     (
#       !BOUND(?eyeCat) || ?eyeCat != :closedstate_instance ||
#       !BOUND(?mouth)  || ?mouth  != :mouth_open_instance
#     )
#   )
# }

# ------------------------
# Q21. Is any state missing its threshold profile?
# ------------------------
# SELECT ?state
# WHERE {
#   ?state rdf:type :ActorState .
#   OPTIONAL { ?state :StateHasThresholdProfile ?tp . }
#   FILTER ( !BOUND(?tp) )
# }

# ------------------------
# Q22. Are there any threshold profiles not used by an Actor State? 
# ------------------------
# SELECT ?tp
# WHERE {
#   ?tp rdf:type :ThresholdProfile .
#   FILTER NOT EXISTS {
#     ?state rdf:type :ActorState ;
#            :StateHasThresholdProfile ?tp .
#   }
# }

