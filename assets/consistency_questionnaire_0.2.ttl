# ------------------------
# Q27. Severe drowsiness (Level 9) must imply Imminent or Unresponsive
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState ;
#          rdf:type :ActorState_Drowsiness_Level_9 ;
#          :ActorStateHasUnresponsiveness ?unrespInd .
#
#   FILTER NOT EXISTS {
#     ?unrespInd rdf:type :Imminent .
#   }
#   FILTER NOT EXISTS {
#     ?unrespInd rdf:type :Unresponsive .
#   }
# }

# ------------------------
# Q28. Moderate drowsiness (Level 5) must be classified as DrowsinessSuspected fatigue
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState ;
#          rdf:type :ActorState_Drowsiness_Level_5 ;
#          :ActorStateHasFatigue ?fatigueInd .
#
#   FILTER NOT EXISTS { ?fatigueInd rdf:type :DrowsinessSuspected . }
# }

# ------------------------
# Q29. Low drowsiness (Level 3) must be classified as Awake fatigue
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState ;
#          rdf:type :ActorState_Drowsiness_Level_3 ;
#          :ActorStateHasFatigue ?fatigueInd .
#
#   FILTER NOT EXISTS { ?fatigueInd rdf:type :Awake . }
# }

# ------------------------
# Q30. Low drowsiness (Level 3) must imply Attentive attention
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState ;
#          rdf:type :ActorState_Drowsiness_Level_3 ;
#          :ActorStateHasAttention ?attInd .
#
#   FILTER NOT EXISTS { ?attInd rdf:type :Attentive . }
# }

# ------------------------
# Q31. High drowsiness (Level 7 or 9) must imply Unresponsiveness or DrowsinessSuspected
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState ;
#          :ActorStateHasUnresponsiveness ?unresp ; 
#          :ActorStateHasFatigue ?ftg . 
#
#   {
#     ?state rdf:type :ActorState_Drowsiness_Level_7 .
#   }
#   UNION
#   {
#     ?state rdf:type :ActorState_Drowsiness_Level_9 .
#   }
#
#   FILTER NOT EXISTS { ?unresp rdf:type :Unresponsive . }
#   FILTER NOT EXISTS { ?ftg rdf:type :DrowsinessSuspected . }
# }


# ------------------------
# Q32. Sleep fatigue must have both eye and mouth state defined
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState ;
#          :ActorStateHasFatigue ?fatigueInd .
#   ?fatigueInd rdf:type :Sleep .
#
#   OPTIONAL { ?state :ActorHasEyeState ?eye . }
#   OPTIONAL { ?state :ActorHasMouthState ?mouth . }
#
#   FILTER ( !BOUND(?eye) || !BOUND(?mouth) )
# }


# ------------------------
# Q33. Awake fatigue must be Responsive and Attentive
# ------------------------
# SELECT ?state WHERE {
#   ?state rdf:type :ActorState ;
#          :ActorStateHasFatigue ?fatigueInd .
#   ?fatigueInd rdf:type :Awake .
#
#   OPTIONAL { ?state :ActorStateHasAttention ?attInd . }
#   OPTIONAL { ?state :ActorStateHasUnresponsiveness ?unrespInd . }
#
#   FILTER (
#       !BOUND(?attInd) ||
#       !BOUND(?unrespInd) ||
#       NOT EXISTS { ?attInd rdf:type :Attentive } ||
#       NOT EXISTS { ?unrespInd rdf:type :Responsive }
#   )
# }

# ------------------------
# Q34. High-risk states (Sleep or Unresponsive) must have at least one Label
# ------------------------
# SELECT ?state
# WHERE {
#   ?state rdf:type :ActorState .
#
#   # Link state to its actor (adjust this property name if needed)
#
#   # High-risk condition: Sleep fatigue OR Unresponsive
#   {
#     ?state :ActorStateHasFatigue ?fatigueInd .
#     ?fatigueInd rdf:type :Sleep .
#   }
#   UNION
#   {
#     ?state :ActorStateHasUnresponsiveness ?unrespInd .
#     ?unrespInd rdf:type :Unresponsive .
#   }
#
#   # Check that NO label in the graph targets this state
#   FILTER NOT EXISTS {
#     ?label rdf:type :Label ;
#          :LabelTargetsActor ?state .
#   }
# }

# ------------------------
# Q35. Every Label must target at least one ActorState
# ------------------------
# SELECT ?label
# WHERE {
