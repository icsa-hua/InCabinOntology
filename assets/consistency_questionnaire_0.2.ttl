# ------------------------
# Q17-A. HR instances with >1 HR level
# ------------------------
# SELECT DISTINCT ?h
# WHERE {
#   ?h rdf:type :HR .
#
#   # Two (potentially distinct) level individuals reached via HRVis
#   ?h :HRis ?lv1 .
#   ?h :HRis ?lv2 .
#
#   FILTER (?lv1 != ?lv2)
#
#   # Their level classes
#   ?lv1 rdf:type ?c1 .
#   ?lv2 rdf:type ?c2 .
#
#   FILTER (?c1 != ?c2)
#   FILTER (?c1 IN (:Very_Low_HR, :Low_HR, :Moderate_HR, :High_HR))
#   FILTER (?c2 IN (:Very_Low_HR, :Low_HR, :Moderate_HR, :High_HR))
# }

